# ==========================================================
# Apache Configuration: Clean URL Routing & Security (NFR 4)
# ==========================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Stop rewriting if file or directory physically exists
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all requests to Front Controller
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    # Prevent clickjacking (NFR 2)
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

# Protect sensitive files safely
<IfModule mod_authz_core.c>
    <FilesMatch "(\.env|\.sqlite|\.sql|\.log)$">
        Require all denied
    </FilesMatch>
</IfModule>
